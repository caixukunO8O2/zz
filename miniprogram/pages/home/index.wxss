.home { height: 100vh; background: var(--color-bg); }
.home__safe-top { height: env(safe-area-inset-top); min-height: 44rpx; }
.home__content { padding: 28rpx 36rpx 0; }
.home__safe-bottom { height: calc(env(safe-area-inset-bottom) + 32rpx); }
.brand-row { display: flex; align-items: flex-start; justify-content: space-between; }
.brand { display: block; font-size: 62rpx; font-weight: 700; line-height: 1.08; letter-spacing: 2rpx; }
.brand-subtitle { display: block; margin-top: 10rpx; color: var(--color-muted); font-size: 25rpx; line-height: 1.4; }
.brand-mark { display: flex; gap: 7rpx; align-items: center; justify-content: center; width: 78rpx; height: 52rpx; margin-top: 4rpx; background: rgba(255,255,255,.72); border: 1rpx solid rgba(62,45,33,.08); border-radius: 28rpx; }
.brand-mark view { width: 6rpx; height: 6rpx; background: var(--color-text); border-radius: 50%; }
.hero { height: 310rpx; margin-top: 36rpx; overflow: hidden; background: #f1c2a3; border-radius: var(--radius-md); }
.hero__image { width: 100%; height: 100%; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin-top: 40rpx; font-size: 34rpx; font-weight: 650; line-height: 1.3; }
.section-heading__count { color: var(--color-muted); font-size: 22rpx; font-weight: 400; }
.filters { width: 100%; margin-top: 22rpx; white-space: nowrap; }
.filters__inner { display: inline-flex; gap: 14rpx; padding-right: 36rpx; }
.filter { min-width: 108rpx; height: 60rpx; padding: 0 26rpx; color: var(--color-muted); font-size: 24rpx; line-height: 60rpx; background: rgba(255,255,255,.62); border: 1rpx solid rgba(60,45,34,.08); border-radius: 32rpx; }
.filter--active { color: #fff; font-weight: 600; background: var(--color-primary); border-color: var(--color-primary); }
.food-list, .loading-list { display: flex; flex-direction: column; gap: 18rpx; margin-top: 24rpx; }
.skeleton { height: 148rpx; background: linear-gradient(100deg, #f1eae0 20%, #faf6f0 45%, #f1eae0 70%); background-size: 220% 100%; border-radius: var(--radius-md); animation: shimmer 1.4s linear infinite; }
@keyframes shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
.error-state, .empty-state { display: flex; align-items: center; flex-direction: column; padding: 68rpx 24rpx 44rpx; text-align: center; }
.empty-state__shape { display: flex; width: 120rpx; height: 120rpx; align-items: center; justify-content: center; background: #f5d7c3; border-radius: 38rpx; transform: rotate(-5deg); }
.empty-state__shape view { width: 44rpx; height: 62rpx; border: 5rpx solid rgba(125,77,48,.5); border-radius: 14rpx; }
.error-state__title, .empty-state__title { margin-top: 24rpx; font-size: 30rpx; font-weight: 600; }
.error-state__body, .empty-state__body { max-width: 480rpx; margin-top: 12rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.6; }
.secondary-button { min-width: 240rpx; height: 76rpx; margin-top: 30rpx; padding: 0 32rpx; color: var(--color-primary); font-size: 26rpx; font-weight: 600; line-height: 76rpx; background: #fff; border: 1rpx solid rgba(223,91,42,.28); border-radius: 40rpx; }
.reminder { margin-top: 34rpx; padding: 24rpx; background: #fbe6d8; border: 1rpx solid rgba(205,112,63,.12); border-radius: var(--radius-md); }
.reminder__heading { display: flex; align-items: center; justify-content: space-between; font-size: 27rpx; font-weight: 600; }
.reminder__heading image { width: 32rpx; height: 32rpx; opacity: .7; }
.reminder__content { display: flex; align-items: center; gap: 20rpx; margin-top: 20rpx; padding: 16rpx; background: rgba(255,255,255,.78); border-radius: 20rpx; }
.reminder__content image, .reminder__fallback { width: 76rpx; height: 64rpx; flex: 0 0 76rpx; background: #efc2a4; border-radius: 14rpx; }
.reminder__content text { font-size: 26rpx; line-height: 1.45; }
.scan-button { display: flex; height: 96rpx; align-items: center; justify-content: center; gap: 16rpx; margin-top: 32rpx; color: #fff; font-size: 31rpx; font-weight: 600; line-height: 96rpx; background: var(--color-primary); border-radius: 48rpx; box-shadow: 0 14rpx 32rpx rgba(199,70,28,.18); }
.scan-button image { width: 38rpx; height: 38rpx; filter: brightness(0) invert(1); }
.scan-button--pressed { background: var(--color-primary-pressed); transform: scale(.992); }
