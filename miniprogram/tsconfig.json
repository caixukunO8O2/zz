{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["miniprogram-api-typings", "vitest/globals"],
    "lib": ["ES2021"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "include": ["**/*.ts", "eslint.config.mjs"]
}
