.scan-page, .camera { width: 100vw; height: 100vh; background: #17110d; }
.scan-scrim { position: absolute; inset: 0; display: flex; flex-direction: column; color: #fff; background: linear-gradient(180deg, rgba(22,15,10,.74) 0%, rgba(20,14,10,.08) 26%, rgba(20,14,10,.04) 54%, rgba(20,14,10,.88) 100%); }
.scan-safe-top { height: env(safe-area-inset-top); min-height: 44rpx; }
.scan-top { display: grid; grid-template-columns: 72rpx 1fr 72rpx; align-items: center; padding: 18rpx 28rpx 0; }
.scan-title { font-size: 34rpx; font-weight: 600; text-align: center; }
.round-control { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; padding: 0; background: rgba(35,29,25,.52); border: 1rpx solid rgba(255,255,255,.22); border-radius: 50%; backdrop-filter: blur(14rpx); }
.round-control image { width: 34rpx; height: 34rpx; filter: brightness(0) invert(1); }
.round-control--active { background: rgba(223,91,42,.84); }
.scan-guidance { margin: 32rpx 56rpx 0; font-size: 27rpx; font-weight: 500; line-height: 1.45; text-align: center; text-shadow: 0 2rpx 10rpx rgba(0,0,0,.38); }
.alignment-frame { position: relative; width: calc(100vw - 104rpx); height: 650rpx; margin: 42rpx auto 0; }
.corner { position: absolute; width: 66rpx; height: 66rpx; border-color: rgba(255,255,255,.94); border-style: solid; }
.corner--tl { top: 0; left: 0; border-width: 5rpx 0 0 5rpx; border-radius: 28rpx 0 0 0; }
.corner--tr { top: 0; right: 0; border-width: 5rpx 5rpx 0 0; border-radius: 0 28rpx 0 0; }
.corner--bl { bottom: 0; left: 0; border-width: 0 0 5rpx 5rpx; border-radius: 0 0 0 28rpx; }
.corner--br { right: 0; bottom: 0; border-width: 0 5rpx 5rpx 0; border-radius: 0 0 28rpx 0; }
.scan-bottom { margin-top: auto; padding: 0 26rpx calc(env(safe-area-inset-bottom) + 28rpx); }
.frame-count { display: block; margin-bottom: 20rpx; font-size: 23rpx; text-align: center; }
.capture-row { display: grid; grid-template-columns: 1fr 132rpx 1fr; align-items: end; margin-top: 34rpx; }
.album-control, .stop-control { display: flex; height: 94rpx; align-items: center; flex-direction: column; justify-content: center; gap: 8rpx; padding: 0; color: #fff; font-size: 22rpx; line-height: 1.2; background: transparent; }
.album-control image { width: 44rpx; height: 44rpx; filter: brightness(0) invert(1); }
.stop-control { justify-self: end; width: 98rpx; }
.shutter { display: flex; width: 132rpx; height: 132rpx; align-items: center; justify-content: center; padding: 0; background: transparent; border: 6rpx solid #fff; border-radius: 50%; }
.shutter view { width: 100rpx; height: 100rpx; background: #fff; border-radius: 50%; transition: transform .15s ease; }
.shutter--busy view { background: rgba(255,255,255,.55); transform: scale(.72); }
.timeout { margin: 22rpx 18rpx 0; padding: 22rpx; font-size: 23rpx; text-align: center; background: rgba(32,25,20,.72); border-radius: 22rpx; backdrop-filter: blur(14rpx); }
.timeout view { display: flex; gap: 14rpx; justify-content: center; margin-top: 16rpx; }
.timeout button, .retry button { height: 58rpx; padding: 0 24rpx; color: #fff; font-size: 22rpx; line-height: 58rpx; background: rgba(255,255,255,.14); border-radius: 30rpx; }
.retry { display: flex; justify-content: center; margin-top: 16rpx; }
.camera-denied { display: flex; height: 100vh; align-items: center; flex-direction: column; justify-content: center; padding: 0 64rpx; color: var(--color-text); text-align: center; background: var(--color-bg); box-sizing: border-box; }
.camera-denied__shape { display: flex; width: 140rpx; height: 140rpx; align-items: center; justify-content: center; background: #f4d4bf; border-radius: 44rpx; }
.camera-denied__shape image { width: 62rpx; height: 62rpx; opacity: .72; }
.camera-denied__title { margin-top: 38rpx; font-size: 36rpx; font-weight: 650; }
.camera-denied__body { margin-top: 16rpx; color: var(--color-muted); font-size: 26rpx; line-height: 1.6; }
.fallback-primary, .fallback-secondary { width: 100%; height: 88rpx; margin-top: 34rpx; font-size: 28rpx; font-weight: 600; line-height: 88rpx; border-radius: 44rpx; }
.fallback-primary { color: #fff; background: var(--color-primary); }
.fallback-secondary { margin-top: 18rpx; color: var(--color-primary); background: #fff; border: 1rpx solid rgba(223,91,42,.28); }
