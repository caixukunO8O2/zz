.manual { height: 100vh; background: var(--color-bg); }
.manual__safe-top { height: env(safe-area-inset-top); min-height: 36rpx; }
.manual__nav { display: grid; grid-template-columns: 72rpx 1fr 72rpx; align-items: center; padding: 16rpx 28rpx; font-size: 36rpx; font-weight: 700; text-align: center; }
.manual__nav button { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; padding: 0; background: transparent; }
.manual__nav image { width: 36rpx; height: 36rpx; }
.manual__content { padding: 28rpx 36rpx 0; }
.manual__title { display: block; font-size: 42rpx; font-weight: 700; line-height: 1.3; }
.manual__subtitle { display: block; margin-top: 14rpx; color: var(--color-muted); font-size: 28rpx; font-weight: 450; line-height: 1.6; }
.manual-form { margin-top: 34rpx; padding: 0 28rpx; background: var(--color-surface); border: 1rpx solid rgba(63,45,32,.08); border-radius: var(--radius-md); }
.manual-form label, .manual-form picker > view { display: flex; min-height: 100rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid rgba(63,45,32,.08); font-size: 30rpx; }
.manual-form__last { border-bottom: 0 !important; }
.manual-form input { width: 360rpx; color: var(--color-muted); font-size: 29rpx; text-align: right; }
.manual-form label > text:first-child, .manual-form picker text:first-child { font-weight: 500; }
.manual-form label > input, .manual-form picker text:last-child { color: var(--color-muted); }
.inline-input { display: flex; align-items: center; gap: 8rpx; color: var(--color-muted); }
.inline-input input { width: 150rpx; }
.manual__save { height: 98rpx; margin-top: 32rpx; color: #fff; font-size: 32rpx; font-weight: 650; line-height: 98rpx; background: var(--color-primary); border-radius: 49rpx; }
.manual__safe-bottom { height: calc(env(safe-area-inset-bottom) + 36rpx); }
